APP_IMAGE=your-existing-application:version
ANKAH_IMAGE=ankah:first-deployment
# Relative to deploy/compose/compose.yml. Use an absolute checkout path if moved.
ANKAH_SOURCE=../..
ANKAH_PACKAGE_STAGE=source-build
# For release-fetch, both are required. Use the checksum from the same release host.
ANKAH_VERSION=
ANKAH_SHA256=
