diff --git a/dots_server/models/external_acl_receiver.go b/dots_server/models/external_acl_receiver.go
new file mode 100644
index 0000000..0b3d6e1
--- /dev/null
+++ b/dots_server/models/external_acl_receiver.go
@@ -0,0 +1,159 @@
+package models
+
+import (
+	"errors"
+	"sync"
+	"time"
+
+	types "github.com/nttdots/go-dots/dots_common/types/data"
+	log "github.com/sirupsen/logrus"
+)
+
+// External-ACL hands validated data channel ACLs to an enforcement point in
+// the same process instead of a router. It keeps the normal protection
+// bookkeeping (protection rows, blocker load) so the data channel controllers
+// behave exactly as they do for the other blocker types.
+
+const (
+	BLOCKER_TYPE_EXTERNAL_ACL = "External-ACL"
+	PROTECTION_TYPE_EXTERNAL  = "ExternalACL"
+)
+
+// ExternalACLHandler receives ACL activations and deactivations.
+// aclID is the data_acls row id, which stays stable while the ACL is updated.
+type ExternalACLHandler interface {
+	InstallACL(customerID int, aclID int64, acl *types.ACL) error
+	RemoveACL(customerID int, aclID int64, aclName string) error
+}
+
+var (
+	externalACLHandlerMu sync.RWMutex
+	externalACLHandler   ExternalACLHandler
+)
+
+func RegisterExternalACLHandler(h ExternalACLHandler) {
+	externalACLHandlerMu.Lock()
+	defer externalACLHandlerMu.Unlock()
+	externalACLHandler = h
+}
+
+func currentExternalACLHandler() ExternalACLHandler {
+	externalACLHandlerMu.RLock()
+	defer externalACLHandlerMu.RUnlock()
+	return externalACLHandler
+}
+
+// implements Protection
+type ExternalACL struct {
+	ProtectionBase
+	acl *types.ACL
+}
+
+func (p ExternalACL) Type() ProtectionType {
+	return PROTECTION_TYPE_EXTERNAL
+}
+
+// implements Blocker
+type ExternalACLReceiver struct {
+	BlockerBase
+}
+
+func NewExternalACLReceiver(base BlockerBase) *ExternalACLReceiver {
+	return &ExternalACLReceiver{base}
+}
+
+func (e *ExternalACLReceiver) Type() BlockerType {
+	return BLOCKER_TYPE_EXTERNAL_ACL
+}
+
+func (e *ExternalACLReceiver) Connect() error {
+	return nil
+}
+
+func (e *ExternalACLReceiver) GenerateProtectionCommand(m *MitigationScope) (string, error) {
+	return "", nil
+}
+
+func (e *ExternalACLReceiver) RegisterProtection(r *MitigationOrDataChannelACL, targetID int64, customerID int, targetType string) (Protection, error) {
+	if r.DataChannelACL == nil {
+		return nil, errors.New("External-ACL only supports data channel ACLs")
+	}
+	base := ProtectionBase{
+		0,
+		customerID,
+		targetID,
+		targetType,
+		r.DataChannelACL.Name,
+		"",
+		"",
+		e,
+		false,
+		time.Unix(0, 0),
+		time.Unix(0, 0),
+		time.Unix(0, 0),
+		NewProtectionStatus(0, 0, 0, 0, 0),
+	}
+	dbP, err := CreateProtection2(&ExternalACL{base, nil})
+	if err != nil {
+		return nil, err
+	}
+	p, err := GetProtectionById(dbP.Id)
+	if err != nil {
+		return nil, err
+	}
+	t, ok := p.(*ExternalACL)
+	if !ok {
+		return nil, errors.New("Protection type error")
+	}
+	acl := *r.DataChannelACL
+	t.acl = &acl
+	return t, nil
+}
+
+func (e *ExternalACLReceiver) ExecuteProtection(p Protection) error {
+	t, ok := p.(*ExternalACL)
+	if !ok || t.acl == nil {
+		log.Warnf("ExternalACLReceiver::ExecuteProtection protection type error. %T", p)
+		return errors.New("Protection type error")
+	}
+	h := currentExternalACLHandler()
+	if h == nil {
+		return errors.New("External-ACL handler is not registered")
+	}
+	if err := h.InstallACL(t.CustomerId(), t.TargetId(), t.acl); err != nil {
+		return err
+	}
+	if err := StartProtection(p, e); err != nil {
+		if rmErr := h.RemoveACL(t.CustomerId(), t.TargetId(), t.AclName()); rmErr != nil {
+			log.WithError(rmErr).Error("External-ACL rollback failed")
+		}
+		return err
+	}
+	return nil
+}
+
+func (e *ExternalACLReceiver) StopProtection(p Protection) error {
+	t, ok := p.(*ExternalACL)
+	if !ok {
+		log.Warnf("ExternalACLReceiver::StopProtection protection type error. %T", p)
+		return errors.New("Protection type error")
+	}
+	if !t.isEnabled {
+		return errors.New("Protection not started")
+	}
+	h := currentExternalACLHandler()
+	if h == nil {
+		return errors.New("External-ACL handler is not registered")
+	}
+	if err := h.RemoveACL(t.CustomerId(), t.TargetId(), t.AclName()); err != nil {
+		return err
+	}
+	return StopProtection(p, e)
+}
+
+func (e *ExternalACLReceiver) UnregisterProtection(p Protection) error {
+	if _, ok := p.(*ExternalACL); !ok {
+		return errors.New("Protection type error")
+	}
+	return DeleteProtectionById(p.Id())
+}
