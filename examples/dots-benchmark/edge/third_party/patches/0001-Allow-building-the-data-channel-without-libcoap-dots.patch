diff --git a/dots_common/messages/message_libcoap.go b/dots_common/messages/message_libcoap.go
new file mode 100644
index 0000000..5b3c707
--- /dev/null
+++ b/dots_common/messages/message_libcoap.go
@@ -0,0 +1,33 @@
+//go:build !dots_nocoap
+
+package messages
+
+import (
+	"reflect"
+
+	"github.com/nttdots/go-dots/dots_common"
+	"github.com/nttdots/go-dots/libcoap"
+	"github.com/ugorji/go/codec"
+)
+
+type coapType = libcoap.Type
+
+const (
+	coapTypeCon = libcoap.TypeCon
+	coapTypeNon = libcoap.TypeNon
+)
+
+func UnmarshalCbor(pdu *libcoap.Pdu, typ reflect.Type) (interface{}, error) {
+    if len(pdu.Data) == 0 {
+        return nil, nil
+    }
+
+    m := reflect.New(typ).Interface()
+	d := codec.NewDecoderBytes(pdu.Data, dots_common.NewCborHandle())
+    err := d.Decode(m)
+
+    if err != nil {
+        return nil, err
+    }
+    return m, nil
+}
