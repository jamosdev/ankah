@@ -0,0 +1,12 @@
+//go:build dots_nocoap
+
+package messages
+
+// Stand-ins for the libcoap message types when the CoAP signal channel is
+// excluded from the build. Only the data channel is usable in this mode.
+type coapType uint8
+
+const (
+	coapTypeCon coapType = 0
+	coapTypeNon coapType = 1
+)
